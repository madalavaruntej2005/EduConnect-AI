# ==============================================================================
# EduConnect AI — Environment Configuration Template
# NOTE: Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Core Platform Settings
APP_NAME=EduConnect AI
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-very-strong-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,web,backend,.render.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL / SQLite fallback in development)
# In development, leave blank to automatically use local SQLite db.sqlite3
DATABASE_URL=postgres://educonnect:educonnect_secret@localhost:5432/educonnect_db
POSTGRES_DB=educonnect_db
POSTGRES_USER=educonnect
POSTGRES_PASSWORD=educonnect_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Caching Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Background Task Processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Artificial Intelligence (OpenAI API)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS_PER_STUDENT_DAILY=50000

# AI Guardian Autonomous Reliability Engineer
GUARDIAN_PORT=8001
GUARDIAN_HOST=127.0.0.1
GUARDIAN_SECRET_TOKEN=guardian-secure-internal-auth-token-change-in-prod
GUARDIAN_POLL_INTERVAL_SECONDS=15
GUARDIAN_ALERT_EMAIL=admin@educonnect.ai
GUARDIAN_AI_AUTO_RECOVERY=True
GUARDIAN_MAX_HOURLY_AUTO_ACTIONS=10

# External Platform Integrations
# 1. Instagram Graph API
INSTAGRAM_CLIENT_ID=your-meta-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-meta-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/callback/

# 2. WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=your-whatsapp-cloud-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# 3. LinkedIn Official API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback/

# 4. YouTube Data API v3
YOUTUBE_API_KEY=your-google-youtube-api-key

# Media Storage (Cloudinary or AWS S3 Compatible)
# Set USE_S3=True or CLOUDINARY_URL for cloud media, otherwise local media/ is used
USE_CLOUD_STORAGE=False
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Email & Alerting (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-smtp-password
DEFAULT_FROM_EMAIL=EduConnect Alerts <no-reply@educonnect.ai>

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_APP_NAME=EduConnect AI

# Mobile (React Native / Expo)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==============================================================================
# EduConnect AI Guardian - Autonomous Reliability Daemon Dockerfile
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY ai_guardian/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY ai_guardian /app/ai_guardian
COPY .env.example /app/.env.example

CMD ["python", "ai_guardian/guardian_daemon.py"]
